{
  "name": "dsh-vue-auth-analyzer",
  "version": "1.0.0",
  "description": "Vue 3 按钮-权限-API 映射分析器：静态 AST 分析 + AI 补全，一键生成权限与接口的完整映射。支持 v-auth/v-permission 等指令、request/axios/http 等封装、router.push/window.open 导航识别。 · Vue 3 button-permission-API mapping analyzer: static AST analysis + AI completion, generating complete permission-to-API mappings.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "SKILL.md",
    "scripts/vue-auth-api-analyzer.mjs",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "vue",
    "vue3",
    "auth",
    "permission",
    "api-mapping",
    "static-analysis",
    "agent-skill",
    "code-analysis"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@babel/parser": "^7.25.0",
    "@babel/types": "^7.25.0",
    "@vue/compiler-sfc": "^3.5.0",
    "@vue/compiler-dom": "^3.5.0",
    "fast-glob": "^3.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.0-rc.8"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
