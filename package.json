{
  "name": "vue-auth-analyzer",
  "version": "2.2.0",
  "description": "Vue 3 按钮-权限-API 映射分析器：静态 AST 分析 + AI 补全，一键生成权限与接口的完整映射。支持 v-auth/v-permission 等指令、request/axios/http 等封装、router.push/window.open 导航识别。 · Vue 3 button-permission-API mapping analyzer: static AST analysis + AI completion, generating complete permission-to-API mappings.",
  "type": "module",
  "bin": {
    "vue-auth-analyzer": "./bin/vue-auth-analyzer.mjs"
  },
  "main": "scripts/vue-auth-api-analyzer.mjs",
  "exports": {
    ".": "./scripts/vue-auth-api-analyzer.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "scripts/vue-auth-api-analyzer.mjs",
    "agents",
    "metadata.json",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "vue",
    "vue3",
    "auth",
    "permission",
    "api-mapping",
    "static-analysis",
    "agent-tool",
    "code-analysis",
    "cli",
    "codex",
    "cursor",
    "claude",
    "ai-agent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@babel/parser": "^7.25.0",
    "@babel/types": "^7.25.0",
    "@vue/compiler-sfc": "^3.5.0",
    "@vue/compiler-dom": "^3.5.0",
    "fast-glob": "^3.3.0"
  }
}
