{
  "name": "vue-auth-analyzer",
  "version": "3.0.0",
  "description": "Vue 3 按钮-权限-API 映射分析器（AI-First）：静态上下文收集 + AI 全量分析，一键生成权限与接口的完整映射。 · Vue 3 button-permission-API mapping analyzer (AI-First): static context collection + full AI analysis.",
  "type": "module",
  "main": "dsh/index.js",
  "bin": {
    "vue-auth-analyzer": "./bin/vue-auth-analyzer.mjs"
  },
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./dsh/client/client.js",
    "./cordis.patch.yml": "./dsh/cordis.patch.yml",
    "./cli": "./scripts/vue-auth-api-analyzer.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "scripts/vue-auth-api-analyzer.mjs",
    "agents",
    "dsh",
    "metadata.json",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "vue",
    "vue3",
    "auth",
    "permission",
    "api-mapping",
    "static-analysis",
    "agent-tool",
    "code-analysis",
    "cli",
    "codex",
    "cursor",
    "claude",
    "ai-agent"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@babel/parser": "^7.25.0",
    "@babel/types": "^7.25.0",
    "@vue/compiler-sfc": "^3.5.0",
    "@vue/compiler-dom": "^3.5.0",
    "fast-glob": "^3.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.0-rc.8",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    }
  }
}
